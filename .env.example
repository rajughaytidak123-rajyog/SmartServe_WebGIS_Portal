# =============================================================================
# SmartServe GIS - Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# =============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL 16/18 with PostGIS 3.4+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartserve_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Direct Database URL (used by SQLAlchemy, GeoAlchemy2, pg_tileserv, pg_featureserv)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/smartserve_db

# 2. FASTAPI BACKEND CONFIGURATION
PROJECT_NAME="SmartServe GIS API"
PROJECT_DESCRIPTION="Location-Based Multi-Service WebGIS Portal for Pune and PCMC"
PROJECT_VERSION="2.0.0"
API_V1_STR="/api/v1"

# CORS Allowed Origins (Comma-separated for production or wildcard for local dev)
CORS_ORIGINS="http://localhost:5500,http://localhost:5600,http://localhost:8000,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:5600,http://127.0.0.1:8000,http://127.0.0.1:8080"

# 3. GEOSERVER OGC SERVICE CONFIGURATION
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=your_geoserver_password_here
GEOSERVER_WORKSPACE=smartserve

# 4. VECTOR TILE SERVICE CONFIGURATION
TILESERV_PORT=7800
FEATURESERV_PORT=9000
PMTILES_PATH=./data/pmtiles

# 5. DOCKER COMPOSE PORT MAPPINGS
DOCKER_POSTGRES_PORT=5432
DOCKER_BACKEND_PORT=8000
DOCKER_CLIENT_PORT=80
DOCKER_TILESERV_PORT=7800
DOCKER_FEATURESERV_PORT=9000
DOCKER_GEOSERVER_PORT=8080
